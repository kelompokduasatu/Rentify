// Skema Prisma modul Autentikasi Rentify.
// Model Account/Session/VerificationToken mengikuti persis skema resmi
// @auth/prisma-adapter — jangan ubah nama kolom/tipe di sana.

// Database sementara di Supabase. DATABASE_URL = connection string pooled
// (pgbouncer) untuk aplikasi; DIRECT_URL = koneksi langsung, dipakai
// `prisma migrate` karena migration tidak jalan lewat pooler.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  HOST
  GUEST
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String             @unique
  emailVerified      DateTime?
  image              String?
  // null untuk akun yang murni dibuat lewat Google OAuth
  passwordHash       String?
  role               UserRole           @default(GUEST)
  phone              String?
  // dipakai modul e-KYC nanti, belum ada alurnya di modul ini
  verificationStatus VerificationStatus @default(UNVERIFIED)

  accounts Account[]
  sessions Session[]

  // createdAt sengaja TANPA @updatedAt supaya nilainya tidak ikut berubah saat update
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Tetap ada demi kompatibilitas @auth/prisma-adapter.
// Selama strategi sesi "jwt" dipakai, tabel ini memang kosong.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
