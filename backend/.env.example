# Database: Supabase (sementara). Ambil dari Supabase Dashboard ->
# Project Settings -> Database -> Connection string. Ganti [PASSWORD],
# [PROJECT-REF], dan [REGION] dengan milik project tim.
#
# DATABASE_URL: pooled (Transaction pooler, port 6543) untuk aplikasi.
# Wajib ada ?pgbouncer=true supaya Prisma tidak memakai prepared statement.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: koneksi langsung (port 5432) khusus untuk `prisma migrate`.
# Kalau jaringanmu tidak mendukung IPv6, pakai Session pooler (port 5432 di host pooler).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Secret penandatangan JWT sesi — buat dengan: npx auth secret
AUTH_SECRET="ganti-dengan-string-acak-panjang"

# URL publik backend — origin saja, TANPA /api/auth.
# @auth/express menurunkan basePath dari titik mounting; menulis path di sini
# memicu peringatan env-url-basepath-redundant.
AUTH_URL="http://localhost:4000"

# Kredensial OAuth dari Google Cloud Console
# Authorized redirect URI: http://localhost:4000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Origin frontend yang boleh memanggil API (pisahkan dengan koma bila lebih dari satu)
CORS_ORIGIN="http://localhost:3000"

PORT=4000
